# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ_your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJ_your_service_role_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# AI Configuration (groq / gemini / mock)
AI_PROVIDER=groq

# Groq LPU Configuration (Single key or comma-separated pool for rotation: key1,key2,key3)
GROQ_API_KEYS=gsk_your_groq_api_key_1,gsk_your_groq_api_key_2
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini Configuration (Single key or comma-separated pool for rotation: key1,key2,key3)
GEMINI_API_KEYS=AIzaSyYourGeminiKey1,AIzaSyYourGeminiKey2
GEMINI_MODEL=gemini-1.5-flash
